# Copy this file to .env and fill in your own token. Never commit .env.
#   PowerShell:  Copy-Item .env.example .env

# ASU CreateAI project service token (the token itself, no "Bearer" prefix)
CREATEAI_API_KEY=your_project_service_token_here
CREATEAI_BASE_URL=https://api-main.aiml.asu.edu

# Optional: pick a different model (CreateAI IDs look like provider/model)
# LLM_MODEL=openai/gpt6_luna
